{
  "name": "moongate-theme",
  "displayName": "Moongate Theme",
  "type": "module",
  "description": "Where Moon Meets Code — a low-glare dark & light theme, WCAG-verified",
  "publisher": "yuelinghuashu",
  "icon": "images/icon.png",
  "version": "2.7.1",
  "engines": {
    "vscode": "^1.130.0"
  },
  "categories": [
    "Themes"
  ],
  "extensionKind": [
    "ui"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/badge/Go-supported-00ADD8",
      "href": "https://github.com/yuelinghuashu/moongate-theme",
      "description": "Go language fully supported"
    },
    {
      "url": "https://img.shields.io/badge/Design%20Tokens-DTCG%20inspired-blue",
      "href": "https://github.com/yuelinghuashu/moongate-theme/blob/main/docs/DESIGN_SYSTEM.md",
      "description": "DTCG-inspired design tokens with WCAG validation"
    }
  ],
  "contributes": {
    "themes": [
      {
        "label": "Moongate Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/moongate-theme-dark.json"
      },
      {
        "label": "Moongate Light",
        "uiTheme": "vs",
        "path": "./themes/moongate-theme-light.json"
      }
    ],
    "configurationDefaults": {
      "editor.semanticHighlighting.enabled": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yuelinghuashu/moongate-theme.git"
  },
  "keywords": [
    "moongate",
    "dark theme",
    "light theme",
    "minimal",
    "semantic highlighting",
    "python",
    "golang",
    "typescript",
    "javascript",
    "react",
    "c++",
    "java",
    "csharp",
    "moon"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test \"test/*.test.js\"",
    "test:scopes": "node scripts/verify-scopes.js",
    "watch": "nodemon --watch src -e yaml --exec \"pnpm run build\"",
    "dev": "pnpm run watch",
    "package": "pnpm run build && vsce package",
    "publish": "pnpm run build && vsce publish",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "js-yaml": "^4.1.1",
    "nodemon": "^3.1.14",
    "wcag-contrast": "^3.0.0"
  }
}
